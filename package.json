{
  "name": "open-lovable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-studio.mjs --dev",
    "build": "next build && npm run build:worker",
    "start": "node scripts/start-studio.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:api": "tsx --import ./tests/setup.mjs --test tests/api.test.ts tests/access.test.ts",
    "test:code": "tsx --import ./tests/setup.mjs --test tests/providers.test.ts tests/validation.test.ts tests/export.test.ts",
    "test:all": "npm test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:worker && tsx --import ./tests/setup.mjs --test-concurrency=1 --test tests/*.test.ts && npm run test:roadmap",
    "test:integration": "tsx --import ./tests/setup.mjs --test tests/integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run check:admission && npm run lint && npm run typecheck && npm test && npm run build",
    "security:audit": "npm audit --audit-level=low",
    "test:roadmap": "tsx --import ./tests/setup.mjs --test-concurrency=1 --test tests/roadmap/*.test.ts && node scripts/test-roadmap-mjs.mjs",
    "verify:baseline": "node scripts/verification/baseline.mjs",
    "check:admission": "tsx scripts/admission-check.ts",
    "recovery": "tsx scripts/recovery.ts",
    "test:postgres": "tsx --import ./tests/setup.mjs --test tests/postgres/*.test.ts",
    "postgres:admin": "tsx scripts/postgres.ts",
    "test:auth-server": "tsx --import ./tests/setup.mjs --test tests/identity-server/*.test.ts",
    "dev:web": "next dev --turbopack --hostname 127.0.0.1",
    "build:worker": "node scripts/build-worker.mjs",
    "start:web": "next start",
    "worker": "node .open-lovable-build/agent-worker.cjs",
    "worker:dev": "node --import tsx workers/agent-worker.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.1",
    "@ai-sdk/google": "^2.0.4",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/openai": "^2.0.4",
    "@anthropic-ai/sdk": "^0.57.0",
    "@e2b/code-interpreter": "^2.0.0",
    "@mendable/firecrawl-js": "^4.3.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.34.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/sandbox": "^0.0.17",
    "ai": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "framer-motion": "^12.23.12",
    "groq-sdk": "^0.29.0",
    "jotai": "^2.14.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.532.0",
    "motion": "^12.23.12",
    "nanoid": "^5.1.5",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "pixi.js": "^8.13.1",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-syntax-highlighter": "^15.6.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "undici": "6.28.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "prismjs": "1.30.0",
    "@ai-sdk/provider-utils": {
      "undici": "6.28.1"
    }
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  }
}
